# Server Configuration
SERVER_PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atento5_mail
DB_USER=postgres
DB_PASSWORD=changeme

# JWT Secret (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=change-me-in-production

# IMAP Configuration
IMAP_HOST=mail.atento5.com
IMAP_PORT=993

# SMTP Configuration
SMTP_HOST=smtp.atento5.com
SMTP_PORT=587
SMTP_SECURE=false

# Email accounts (comma separated)
EMAIL_ACCOUNTS=Juan.ampuero@atento5.com,Corina.anorga@atento5.com

# Sync interval in milliseconds (default: 30000 = 30 seconds)
SYNC_INTERVAL=30000
